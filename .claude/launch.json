{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "store",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vertex-digital/store", "dev"],
      "port": 3001,
      "url": "http://127.0.0.1:3001"
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vertex-digital/admin", "dev"],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vertex-digital/api", "dev"],
      "env": {
        "SUPPLIER_FAKE_ENABLED": "true"
      },
      "port": 3000
    },
    {
      "name": "api-build",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vertex-digital/api", "start"],
      "env": {
        "SUPPLIER_FAKE_ENABLED": "true"
      },
      "port": 3000
    }
  ]
}
