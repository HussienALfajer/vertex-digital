# Copy to .env (git-ignored). Every value here is a placeholder: never put a real secret in this file.
# Production values live only in the server's shared/.env (mode 600). Supplier API keys are NOT
# environment variables: they are entered in the admin panel and stored encrypted (ADR 0005).
NODE_ENV=development
LOG_LEVEL=debug

# --- Hosts and ports ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
STORE_PORT=3001
# Public origins. The API is reached under each at /api.
STORE_URL=http://127.0.0.1:3001
ADMIN_URL=http://127.0.0.1:5173
# How the store's server components reach the API (never through the public host).
API_INTERNAL_URL=http://127.0.0.1:3000
# Shared secret for the store's internal cache revalidation endpoint (127.0.0.1 only).
STORE_REVALIDATE_SECRET=replace-with-a-long-random-value

WORKER_NAME=local

# --- Database (ADR 0014) -----------------------------------------------------
# The apps connect as the app role: no DDL, no UPDATE/DELETE on the ledger.
DATABASE_URL=postgres://vertex_digital:change-me@127.0.0.1:5432/vertex_digital
TEST_DATABASE_URL=postgres://vertex_digital:change-me@127.0.0.1:5432/vertex_digital_test
# The owner role owns the tables and runs the migrations only. In production it is not in this file:
# it lives in /etc/vertexdigital/owner.env, read by the deploy only (docs/deployment.md).
DATABASE_OWNER_URL=postgres://vertex_digital_owner:change-me-owner@127.0.0.1:5432/vertex_digital
TEST_DATABASE_OWNER_URL=postgres://vertex_digital_owner:change-me-owner@127.0.0.1:5432/vertex_digital_test

# --- Auth (ADR 0007) -----------------------------------------------------------
# Separate secrets for the customer and admin Better Auth instances (`openssl rand -hex 32`).
CUSTOMER_AUTH_SECRET=replace-with-a-long-random-value
ADMIN_AUTH_SECRET=replace-with-another-long-random-value

# --- Bot protection (ADR 0008) -------------------------------------------------
ALTCHA_HMAC_KEY=replace-with-a-long-random-value

# --- Secrets at rest (ADR 0005) ------------------------------------------------
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts supplier API keys in the database.
SUPPLIER_KEYS_SECRET=replace-with-32-random-bytes-base64
# A different 32-byte key. Encrypts gift card and voucher codes delivered to customers (ADR 0004).
PRODUCT_CODES_SECRET=replace-with-other-32-random-bytes-base64

# --- Files ---------------------------------------------------------------------
# Receipts and QR images (S03). Production: an absolute path outside the releases (shared/files).
# A relative path is the API's (apps/api/.data/files); the worker reads receipts there for the
# Telegram deposit cards (S05).
FILES_ROOT=./.data/files
# Production only: the nginx `internal` location that maps to FILES_ROOT, so nginx sends the files
# (X-Accel-Redirect). Empty: the API sends them itself.
FILES_ACCEL_PREFIX=

# --- Email (ADR 0007) ------------------------------------------------------------
# `log` writes .eml files under EMAIL_LOG_DIR (relative to the worker, apps/worker/.data/emails with
# `pnpm dev`) and sends nothing: the default outside production. Production needs `smtp`.
EMAIL_TRANSPORT=log
EMAIL_LOG_DIR=./.data/emails
EMAIL_FROM=info@vertexmedia.pro
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com
SMTP_PASSWORD=replace-me

# --- USDT verification (ADR 0006) -----------------------------------------------
# The worker's chain readers (S04). `fake` reads the transfers that
# `pnpm --filter @vertex-digital/worker usdt:fake-transfer` writes to FAKE_CHAIN_FILE (development;
# refused in production); `live` reads TronGrid and the BSC provider.
CHAIN_READER=fake
FAKE_CHAIN_FILE=./.data/fake-chain.json
TRONGRID_API_URL=https://api.trongrid.io
# Required with `live` when the TRC20 address is set.
TRONGRID_API_KEY=replace-me
# A BSC JSON-RPC endpoint (HTTPS); a provider's key goes in the URL. Required with `live` when the
# BEP20 address is set.
BSC_RPC_URL=
# The owner's receiving addresses (S04 rule U1; never private keys), read by the API and the worker.
# Empty: that network is unavailable. A value failing its checksum stops the start. Change one only
# with no open USDT deposits (docs/deployment.md). For local development with the fake chain, these
# made-up addresses pass the checksums (nobody holds them; never use them with `live`):
# USDT_TRC20_ADDRESS=TD5gsCwxykWsLN9aPrq2TAfNjByuZKYp4E
# USDT_BEP20_ADDRESS=0xabababababababababababababababababababab
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=

# --- Telegram admin bot (F07, ADR 0019) --------------------------------------------
# The bot's username (without @), for the link the panel shows. Empty: the bot is not configured.
# Locally any name works with the `log` transport, e.g. vertex_digital_dev_bot.
TELEGRAM_BOT_USERNAME=
# The webhook's secret header, the same for the API and the worker (`openssl rand -hex 32`).
# Empty locally: the API derives one, and `telegram:fake-update` uses it.
TELEGRAM_WEBHOOK_SECRET=replace-me
# The worker only: the token from BotFather (the API never holds it) and the webhook it registers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
# `log` writes each bot message as a JSON file under TELEGRAM_LOG_DIR (relative to the worker,
# apps/worker/.data/telegram with `pnpm dev`) and calls nothing. Production uses `api` (its default there).
TELEGRAM_TRANSPORT=log
TELEGRAM_LOG_DIR=./.data/telegram

# --- Web push (F24) -----------------------------------------------------------------
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:info@vertexmedia.pro

# --- Error tracking (ADR 0002) --------------------------------------------------------
# Empty disables Sentry (development default).
SENTRY_DSN=
