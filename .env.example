# Copy to .env (git-ignored). Every value here is a placeholder: never put a real secret in this file.
# Production values live only in the server's shared/.env (mode 600). Supplier API keys are NOT
# environment variables: they are entered in the admin panel and stored encrypted (ADR 0005).
NODE_ENV=development
LOG_LEVEL=debug

# --- Hosts and ports ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
STORE_PORT=3001
# Public origins. The API is reached under each at /api.
STORE_URL=http://127.0.0.1:3001
ADMIN_URL=http://127.0.0.1:5173
# How the store's server components reach the API (never through the public host).
API_INTERNAL_URL=http://127.0.0.1:3000
# Shared secret for the store's internal cache revalidation endpoint (127.0.0.1 only).
STORE_REVALIDATE_SECRET=replace-with-a-long-random-value

WORKER_NAME=local

# --- Database (ADR 0014) -----------------------------------------------------
# The apps connect as the app role: no DDL, no UPDATE/DELETE on the ledger.
DATABASE_URL=postgres://vertex_digital:change-me@127.0.0.1:5432/vertex_digital
TEST_DATABASE_URL=postgres://vertex_digital:change-me@127.0.0.1:5432/vertex_digital_test
# The owner role owns the tables and runs the migrations only. In production only the deploy reads it.
DATABASE_OWNER_URL=postgres://vertex_digital_owner:change-me-owner@127.0.0.1:5432/vertex_digital
TEST_DATABASE_OWNER_URL=postgres://vertex_digital_owner:change-me-owner@127.0.0.1:5432/vertex_digital_test

# --- Auth (ADR 0007) -----------------------------------------------------------
# Separate secrets for the customer and staff Better Auth instances (`openssl rand -hex 32`).
CUSTOMER_AUTH_SECRET=replace-with-a-long-random-value
STAFF_AUTH_SECRET=replace-with-another-long-random-value

# --- Bot protection (ADR 0008) -------------------------------------------------
ALTCHA_HMAC_KEY=replace-with-a-long-random-value

# --- Secrets at rest (ADR 0005) ------------------------------------------------
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts supplier API keys in the database.
SUPPLIER_KEYS_SECRET=replace-with-32-random-bytes-base64
# A different 32-byte key. Encrypts gift card and voucher codes delivered to customers (ADR 0004).
PRODUCT_CODES_SECRET=replace-with-other-32-random-bytes-base64

# --- Files ---------------------------------------------------------------------
# Receipts and attachments. Production: an absolute path outside the releases.
FILES_ROOT=./.data/files

# --- Email (ADR 0007) ------------------------------------------------------------
# `log` writes .eml files under EMAIL_LOG_DIR and sends nothing (development default).
EMAIL_TRANSPORT=log
EMAIL_LOG_DIR=./.data/emails
EMAIL_FROM=info@vertexmedia.pro
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com
SMTP_PASSWORD=replace-me

# --- USDT verification (ADR 0006) -----------------------------------------------
# `stub` uses a local chain reader for development and tests; `live` reads the chains.
CHAIN_READER=stub
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=replace-me
BSC_RPC_URL=https://bsc-rpc.example.com
# Receiving addresses only (never private keys). Placeholders below are not real wallets.
USDT_TRC20_ADDRESS=T000000000000000000000000000000000
USDT_BEP20_ADDRESS=0x0000000000000000000000000000000000000000

# --- Telegram admin bot (F07) -----------------------------------------------------
# The worker alert channel (ADR 0002). Empty turns it off; set both together (Q11).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=

# --- Web push (F24) -----------------------------------------------------------------
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:info@vertexmedia.pro

# --- Error tracking (ADR 0002) --------------------------------------------------------
# Empty disables Sentry (development default).
SENTRY_DSN=
