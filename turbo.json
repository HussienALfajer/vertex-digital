{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".node-version"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DATABASE_OWNER_URL",
    "TEST_DATABASE_OWNER_URL",
    "TEST_WORKERS",
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["MADANI_FONTS_DIR"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vertex-digital/admin#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/deploy/nginx/**"],
      "outputs": []
    },
    "@vertex-digital/ui#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/brand/**",
        "$TURBO_ROOT$/apps/store/src/**",
        "$TURBO_ROOT$/apps/admin/src/**"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
