{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".node-version"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DATABASE_OWNER_URL",
    "TEST_DATABASE_OWNER_URL",
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["MADANI_FONTS_DIR"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@vertex-digital/api#test": {
      "dependsOn": ["^build", "@vertex-digital/db#test"],
      "cache": false
    },
    "@vertex-digital/worker#test": {
      "dependsOn": ["^build", "@vertex-digital/api#test", "@vertex-digital/db#test"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
