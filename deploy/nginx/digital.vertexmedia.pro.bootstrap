# Temporary site used only until the first certificate of digital.vertexmedia.pro exists: serves the ACME
# challenge on port 80 and nothing else. It references no certificate, so it can never break
# nginx for the other sites (SERVER.md rule 1). deploy/provision.sh replaces it with digital.vertexmedia.pro.
server {
    listen 80;
    listen [::]:80;
    server_name digital.vertexmedia.pro;
    access_log /var/log/nginx/digital.vertexmedia.pro.access.log;
    error_log /var/log/nginx/digital.vertexmedia.pro.error.log warn;
    location ^~ /.well-known/acme-challenge/ { root /var/www/vertexdigital-acme; }
    location / { return 444; }
}
